{
    "name": "kematjaya/upload-bundle",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Nur Hidayatullah",
            "email": "kematjaya0@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.3",
        "kematjaya/upload": "^6.4",
        "doctrine/doctrine-bundle": "^2.10",
        "doctrine/orm": "^2.14|^3.0",
        "symfony/asset": "^6.4",
        "symfony/doctrine-bridge": "^6.4",
        "symfony/event-dispatcher": "^6.4",
        "symfony/form": "^6.4",
        "symfony/framework-bundle": "^6.4",
        "symfony/http-foundation": "^6.4",
        "symfony/mime": "^6.4",
        "symfony/options-resolver": "^6.4",
        "symfony/routing": "^6.4",
        "symfony/translation": "^6.4",
        "symfony/twig-bundle": "^6.4",
        "symfony/uid": "^6.4",
        "symfony/yaml": "^6.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "symfony/browser-kit": "^6.4",
        "symfony/phpunit-bridge": "^6.4"
    },
    "suggest": {
        "ext-gd": "Dibutuhkan untuk kompresi gambar setelah upload (upload.optimizer.image)"
    },
    "autoload": {
        "psr-4": {
            "Kematjaya\\UploadBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kematjaya\\UploadBundle\\Tests\\": "tests/"
        }
    }
}
